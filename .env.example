DATABASE_URL="mongodb://admin:admin@localhost:27017/relish?authSource=admin&directConnection=true"
# MongoDB admin password must match in DATABASE_URL
ADMIN_PASSWORD="admin"
MONGOT_PASSWORD="mongotPassword"
REDIS_URL="redis://localhost:6379"

YOUTUBE_API_KEY="keyboard cat"
OPENAI_API_KEY="keyboard cat"
GEONAMES_USERNAME=""

# Visual analysis backend: "openai" or "qwen3vl"
VIDEO_ANALYSIS_BACKEND="openai"
QWEN_VL_BASE_URL="http://127.0.0.1:8001/v1"
QWEN_VL_MODEL="Qwen/Qwen3-VL-8B-Instruct"
QWEN_VL_FPS=""
QWEN_VL_MAX_FRAMES="128"
QWEN_VL_MAX_TOKENS="4096"
QWEN_VL_TIMEOUT_MS="600000"

# Transcription backend: "openai" or "local"
TRANSCRIPTION_BACKEND="openai"
LOCAL_ASR_BASE_URL="http://127.0.0.1:8002/v1"
LOCAL_ASR_MODEL="openai/whisper-large-v3"
LOCAL_ASR_TIMEOUT_MS="600000"

# Fusion and recipe extraction backends: "openai" or "local"
FUSION_BACKEND="openai"
EXTRACTION_BACKEND="openai"
LOCAL_LLM_BASE_URL="http://127.0.0.1:8001/v1"
LOCAL_LLM_MODEL="Qwen/Qwen3-VL-8B-Instruct"
LOCAL_LLM_TEMPERATURE="0"
